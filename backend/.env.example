# ExamForge M2 — Environment Configuration Template
# Copy this file to .env and fill in the values
# Never commit the .env file to version control

# ─── Django Core ────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=examforge_db
DB_USER=examforge_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ─── CORS ────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ─── JWT Authentication ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ─── Redis (for caching and Celery) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── File Upload Settings ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# ─── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/examforge_m2.log

# ─── Security ────────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ─── Student Import Settings ─────────────────────────────────────────────────────
STUDENT_IMPORT_MAX_ROWS=5000
STUDENT_IMPORT_BATCH_SIZE=100

# ─── Registration Settings ───────────────────────────────────────────────────────
ALLOW_LATE_REGISTRATION=False
DEFAULT_REGISTRATION_STATUS=registered

# ─── M1 Integration ──────────────────────────────────────────────────────────────
# These settings reference M1's authentication system
AUTH_USER_MODEL=accounts.User
M1_AUTH_APP=accounts

# ─── M3 Integration ──────────────────────────────────────────────────────────────
# ExamSession model reference (owned by M3)
M3_EXAM_SESSION_MODEL=examinations.ExamSession
